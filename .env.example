# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=fitsaas_db
DB_PORT=5436
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/fitsaas_db

# Web Application
PORT=3001
NODE_ENV=development

# JWT Secret
JWT_SECRET=super-secret-fitsaas-token-key-2026

# Optional: Gemini AI Integration (Bonus Section 5.1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: n8n Automation Webhook (Bonus Section 5.2)
N8N_WEBHOOK_URL=
