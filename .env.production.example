# ==============================================================================
# CONFIGURACIÓN PARA DESPLIEGUE EN PRODUCCIÓN (VPS / DOCKER COMPOSE)
# ==============================================================================
# Copia este archivo a .env.production en tu VPS:
# cp .env.production.example .env.production

# Entorno Node.js
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Base de datos PostgreSQL (Red interna Docker, puerto no expuesto al exterior)
POSTGRES_USER=fitsaas_admin
POSTGRES_PASSWORD=GenerarUnaPasswordSeguraDeAlMenos24Caracteres
POSTGRES_DB=fitsaas_prod_db
DATABASE_URL=postgresql://fitsaas_admin:GenerarUnaPasswordSeguraDeAlMenos24Caracteres@postgres:5432/fitsaas_prod_db

# Secreto de Sesión JWT (Generar con: openssl rand -base64 32)
JWT_SECRET=generar_un_secreto_jwt_aleatorio_muy_largo_y_seguro

# Dominio público o IP pública de la VPS
NEXT_PUBLIC_APP_URL=http://tu-dominio-o-ip-vps.com

# Integraciones Opcionales
GEMINI_API_KEY=tu_api_key_de_google_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash
N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/tenant-created
